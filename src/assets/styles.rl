  "1px solid var(--border-color)",// $^&*43  - Card component border
  "1.5rem",                       // $^&*44  - Card interior padding
  "translateY(-2px)",             // $^&*45  - Card hover scale transform
  "0 4px 12px rgba(0, 0, 0, 0.05)", // $^&*46 - Card hover shadow
  "1px solid var(--border-color)",// $^&*47  - Footer top border
  "2rem 0",                       // $^&*48  - Footer padding
  "0.875rem",                     // $^&*49  - Footer font size
  "0.75rem 1.5rem",               // $^&*50  - Button padding
  "600",                          // $^&*51  - Button font weight
  "#ffffff",                      // $^&*52  - Button text color
  "768px",                        // $^&*53  - Tablet media query breakpoint
  "3rem",                         // $^&*54  - Tablet Hero title font size
  "1.5rem",                       // $^&*55  - Tablet navigation list gap
