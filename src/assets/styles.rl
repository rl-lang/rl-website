CONST string STYLE_TEMPLATE =
"/* ==========================================================================
   1. DESIGN SYSTEM & CSS VARIABLES
   ========================================================================== */
:root {
  /* Colors */
  --bg-primary: $^&*1;
  --bg-secondary: $^&*2;
  --text-primary: $^&*3;
  --text-secondary: $^&*4;
  --accent: $^&*5;
  --accent-hover: $^&*6;
  --border-color: $^&*7;

  /* Layout & Spacing */
  --max-width: $^&*8;
  --header-height: $^&*9;
  --radius: $^&*10;
  --transition: $^&*11;
}

/* System-based Dark Mode */
@media (prefers-color-scheme: dark) {
  :root {
    --bg-primary: $^&*12;
    --bg-secondary: $^&*13;
    --text-primary: $^&*14;
    --text-secondary: $^&*15;
    --accent: $^&*16;
    --accent-hover: $^&*17;
    --border-color: $^&*18;
  }
}

/* ==========================================================================
   2. CSS RESET
   ========================================================================== */
*, *::before, *::after {
  box-sizing: border-box;
  margin: $^&*19;
  padding: $^&*20;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: $^&*21;
  background-color: var(--bg-primary);
  color: var(--text-primary);
  line-height: $^&*22;
  -webkit-font-smoothing: antialiased;
}

img, svg {
  display: block;
  max-width: $^&*23;
  height: auto;
}

/* ==========================================================================
   3. MOBILE-FIRST BASE LAYOUT (Stacked by default)
   ========================================================================== */
.site-wrapper {
  display: flex;
  flex-direction: column;
  min-height: $^&*24;
}

.container {
  width: $^&*25;
  max-width: var(--max-width);
  margin-left: auto;
  margin-right: auto;
  padding-left: $^&*26;
  padding-right: $^&*27;
}

/* Header & Navigation */
.site-header {
  background-color: var(--bg-secondary);
  border-bottom: $^&*28;
  position: sticky;
  top: $^&*29;
  z-index: $^&*30;
}

.nav-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--header-height);
}

.logo {
  font-size: $^&*31;
  font-weight: $^&*32;
  text-decoration: none;
  color: var(--accent);
}

.nav-menu {
  display: none;
}

/* Hero Section */
.hero {
  padding: $^&*33;
  text-align: center;
}

.hero h1 {
  font-size: $^&*34;
  line-height: $^&*35;
  margin-bottom: $^&*36;
}

.hero p {
  font-size: $^&*37;
  color: var(--text-secondary);
  margin-bottom: $^&*38;
}

/* Main Content Area & Sidebar Stack */
.main-layout {
  padding: $^&*39;
  display: flex;
  flex-direction: column;
  gap: $^&*40;
}

/* Card Component */
.card-grid {
  display: grid;
  grid-template-columns: $^&*41;
  gap: $^&*42;
}

.card {
  background-color: var(--bg-secondary);
  border: $^&*43;
  border-radius: var(--radius);
  padding: $^&*44;
  transition: var(--transition);
}

.card:hover {
  transform: $^&*45;
  box-shadow: $^&*46;
}

/* Footer */
.site-footer {
  background-color: var(--bg-secondary);
  border-top: $^&*47;
  padding: $^&*48;
  margin-top: auto;
  text-align: center;
  font-size: $^&*49;
  color: var(--text-secondary);
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: $^&*50;
  font-weight: $^&*51;
  border-radius: var(--radius);
  border: none;
  cursor: pointer;
  text-decoration: none;
  transition: var(--transition);
  background-color: var(--accent);
  color: $^&*52;
}

.btn:hover {
  background-color: var(--accent-hover);
}

/* ==========================================================================
   4. DESKTOP & TABLET MEDIA QUERIES
   ========================================================================== */

/* Tablet & Smaller Desktops (768px and up) */
@media (min-width: $^&*53) {
  .hero h1 {
    font-size: $^&*54;
  }

  .nav-menu {
    display: flex;
    gap: $^&*55;
    list-style: none;
  }

  .nav-link {
    text-decoration: none;
    color: var(--text-primary);
    font-weight: $^&*56;
    transition: var(--transition);
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .card-grid {
    grid-template-columns: $^&*57;
  }
}

/* Desktop Screens (1024px and up) */
@media (min-width: $^&*58) {
  .main-layout {
    display: grid;
    grid-template-columns: $^&*59;
    gap: $^&*60;
  }

  .card-grid {
    grid-template-columns: $^&*61;
  }
}"

