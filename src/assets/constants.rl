CONST string HTML =
"<!DOCTYPE html>
<html lang=\"en\">
\t<!-- HEAD -->
$1
\t<!-- END HEAD -->
\t<!-- BODY -->
$2
\t<!-- END BODY -->
</html>"

CONST string HEAD =
"<head>
\t<!-- 1. Required Character Set -->
\t<meta charset=\"utf-8\">
\n\t<!-- 2. Mobile Viewport Scaling -->
\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
\n\t<!-- 3. Page Title (Crucial for SEO and browser tabs) -->
\t<meta name=\"description\" content=\"A brief, compelling description of your page.\">
\n\t<!-- 4. Search Engine Optimization (SEO) -->
\t<meta name=\"description\" content=\"A brief, compelling description of your page.\">
\n\t<!-- 5. Stylesheets (CSS) -->
\t<link rel=\"stylesheet\" href=\"styles.css\">
\n\t<!-- 6. Icons (Favicon) -->
\t<link rel=\"icon\" href=\"favicon.ico\" type=\"image/x-icon\">
\n\t<!-- 7. JavaScript (Optional, can also go at the end of the body) -->
\t<script src=\"script.js\" defer></script>
</head>"
